# GEMINI_API_KEY: Required for optional server-side AI intelligence enrichment.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform JavaScript SDK key (client).
VITE_GOOGLE_MAPS_API_KEY=""

# GOOGLE_MAPS_API_KEY: Optional server-side Google Maps Platform REST key.
GOOGLE_MAPS_API_KEY=""

# SESSION_SECRET: HMAC secret for signing HTTP-only authentication cookies.
SESSION_SECRET=""

# GROQ_API_KEY / OPENROUTER_API_KEY: Optional AI inference provider keys.
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
